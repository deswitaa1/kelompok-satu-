<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowgaritma kel 1"/>
        <attribute name="authors" value="hi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-17 04:32:47 PM"/>
        <attribute name="created" value="aGk7TEFQVE9QLTFCRUcwR0ZQOzIwMjYtMDktMTc7MDE6NDg6MDcgUE07MjUzMw=="/>
        <attribute name="edited" value="aGk7TEFQVE9QLTFCRUcwR0ZQOzIwMjYtMDktMTc7MDQ6MzI6NDcgUE07NDsyNjQ0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <call expression="Start"/>
        </body>
    </function>
    <function name="Start" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pendapatan" type="Real" array="False" size=""/>
            <declare name="jumlahPengeluaran" type="Real" array="False" size=""/>
            <declare name="totalPengeluaran" type="Real" array="False" size=""/>
            <declare name="sisaSaldo" type="Real" array="False" size=""/>
            <declare name="persenSisa" type="Real" array="False" size=""/>
            <declare name="kategori" type="String" array="False" size=""/>
            <declare name="lagi" type="String" array="False" size=""/>
            <declare name="kondisi" type="String" array="False" size=""/>
            <assign variable="totalPengeluaran" expression="0"/>
            <output expression="&quot;Masukkan total pendapatan:&quot;" newline="True"/>
            <input variable="pendapatan"/>
            <do expression="lagi = &quot;ya&quot;">
                <output expression="&quot;Masukkan kategori pengeluaran:&quot;" newline="True"/>
                <input variable="kategori"/>
                <output expression="&quot;Masukkan jumlah pengeluaran:&quot;" newline="True"/>
                <input variable="jumlahPengeluaran"/>
                <assign variable="totalPengeluaran" expression="totalPengeluaran + jumlahPengeluaran"/>
                <output expression="&quot;Tambah pengeluaran lagi? (ya/tidak)&quot;" newline="True"/>
                <input variable="lagi"/>
            </do>
            <assign variable="sisaSaldo" expression="pendapatan - totalPengeluaran"/>
            <assign variable="persenSisa" expression="(sisaSaldo / pendapatan) * 100"/>
            <if expression="persenSisa &gt;= 30">
                <then>
                    <assign variable="kondisi" expression="&quot;baik&quot;"/>
                </then>
                <else>
                    <if expression="persenSisa &gt;= 10">
                        <then>
                            <assign variable="kondisi" expression="&quot;Perlu Perhatian&quot;"/>
                        </then>
                        <else>
                            <assign variable="kondisi" expression="&quot;krisis&quot;"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;=== RINGKASAN ANGGARAN ===&quot;" newline="True"/>
            <output expression="&quot;Pendapatan = &quot; &amp; pendapatan" newline="True"/>
            <output expression="&quot;Total Pengeluaran = &quot; &amp; totalPengeluaran" newline="True"/>
            <output expression="&quot;Sisa Saldo = &quot; &amp; sisaSaldo" newline="True"/>
            <output expression="&quot;Persentase Sisa = &quot; &amp; persenSisa &amp; &quot;%&quot;" newline="True"/>
            <output expression="&quot;Kondisi Keuangan = &quot; &amp; kondisi" newline="True"/>
        </body>
    </function>
</flowgorithm>
